
class Solution {
public:
    int maxDepth(TreeNode* root) {
        if(!root)return 0;
        int l=0,r=0;
        l=maxDepth(root->left)+1;
        r=maxDepth(root->right)+1;
        return max(l,r);
    }
};


class Solution {
public:
    int maxDepth(TreeNode* root) {
        if(!root)return 0;
        return 1+max(maxDepth(root->left),maxDepth(root->right)); 
    }
};
